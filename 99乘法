            { id: 17, name: "足球地鼠", rarity: "N", icon: "⚽", desc: "熱愛運動與熱血競賽！" },
            { id: 18, name: "冰淇淋地鼠", rarity: "N", icon: "🍦", desc: "甜蜜冰涼的好滋味！" },
            { id: 19, name: "氣球地鼠", rarity: "N", icon: "🎈", desc: "飛向天空的夢想氣球！" },
            { id: 20, name: "貓耳地鼠", rarity: "N", icon: "🐱", desc: "戴著貓耳帽子的可愛裝扮！" }
        ];

        /* GAME STATE VARIABLES */
        let state = {
            score: 0,
            tickets: 0,
            pointsProgress: 0,
            selectedTable: 'all',
            currentSpeed: 'normal',
            gameActive: false,
            currentQuestion: { num1: 0, num2: 0, answer: 0 },
            combo: 0,
            maxCombo: 0,
            roundScore: 0,
            roundTicketsEarned: 0,
            timeLeft: 60,
            timerInterval: null,
            inventory: {},
            activeMoles: Array(9).fill(null),
            moleTimer: null
        };

        window.onload = function() {
            loadSavedData();
            updateStatsUI();
            renderCollectionGrid('all');
        };

        function saveData() {
            localStorage.setItem('multiplication_mole_data', JSON.stringify({
                score: state.score,
                tickets: state.tickets,
                pointsProgress: state.pointsProgress,
                inventory: state.inventory
            }));
        }

        function loadSavedData() {
            const data = localStorage.getItem('multiplication_mole_data');
            if (data) {
                try {
                    const parsed = JSON.parse(data);
                    state.score = parsed.score || 0;
                    state.tickets = parsed.tickets || 0;
                    state.pointsProgress = parsed.pointsProgress || 0;
                    state.inventory = parsed.inventory || {};
                } catch(e) {
                    console.error("Save load error", e);
                }
            }
        }

        function switchTab(tabName) {
            document.getElementById('sec-game').classList.add('hidden');
            document.getElementById('sec-gacha').classList.add('hidden');
            document.getElementById('sec-collection').classList.add('hidden');

            document.querySelectorAll('nav button').forEach(btn => {
                btn.classList.remove('border-yellow-300', 'text-yellow-200');
                btn.classList.add('border-transparent', 'text-amber-200');
            });

            if (tabName === 'game') {
                document.getElementById('sec-game').classList.remove('hidden');
                document.getElementById('tab-game').classList.add('border-yellow-300', 'text-yellow-200');
            } else if (tabName === 'gacha') {
                document.getElementById('sec-gacha').classList.remove('hidden');
                document.getElementById('tab-gacha').classList.add('border-yellow-300', 'text-yellow-200');
            } else if (tabName === 'collection') {
                document.getElementById('sec-collection').classList.remove('hidden');
                document.getElementById('tab-collection').classList.add('border-yellow-300', 'text-yellow-200');
                renderCollectionGrid('all');
            }
        }

        function selectMode(table) {
            state.selectedTable = table;
            document.querySelectorAll('.btn-mode').forEach(btn => {
                btn.classList.remove('active', 'bg-amber-500', 'text-white', 'border-amber-500');
                btn.classList.add('bg-amber-50', 'text-amber-800', 'border-amber-300');
            });
            const selectedBtn = document.querySelector(`.btn-mode[data-table="${table}"]`);
            if (selectedBtn) {
                selectedBtn.classList.remove('bg-amber-50', 'text-amber-800', 'border-amber-300');
                selectedBtn.classList.add('active', 'bg-amber-500', 'text-white', 'border-amber-500');
            }
        }

        function startGame() {
            const speedRadios = document.getElementsByName('speed');
            for(let r of speedRadios) {
                if(r.checked) state.currentSpeed = r.value;
            }

            state.gameActive = true;
            state.combo = 0;
            state.maxCombo = 0;
            state.roundScore = 0;
            state.roundTicketsEarned = 0;

            document.getElementById('combo-count').innerText = '0';

            document.getElementById('panel-mode-select').classList.add('hidden');
            document.getElementById('panel-game-arena').classList.remove('hidden');

            const isChallenge = (state.selectedTable === 'all');
            const modeLabel = isChallenge ? '全綜合 (1~9 挑戰)' : `${state.selectedTable} 的乘法 (練習)`;
            document.getElementById('badge-current-mode').innerText = `模式: ${modeLabel}`;

            const timerBox = document.getElementById('timer-box');
            const timerLabel = document.getElementById('timer-label');
            const timerText = document.getElementById('game-timer');

            if (isChallenge) {
                state.timeLeft = 60;
                timerBox.className = 'bg-rose-500 text-white px-3.5 py-1.5 rounded-2xl font-black text-base flex items-center space-x-1.5 shadow-md border border-rose-400';
                timerLabel.innerText = '剩餘:';
                timerText.innerText = '60s';
                startCountdownTimer();
            } else {
                clearInterval(state.timerInterval);
                timerBox.className = 'bg-sky-500 text-white px-3.5 py-1.5 rounded-2xl font-black text-base flex items-center space-x-1.5 shadow-md border border-sky-400';
                timerLabel.innerText = '練習模式:';
                timerText.innerText = '無限時 ♾️';
            }

            generateNextQuestion();
            startMoleCycle();
        }

        function stopGame() {
            state.gameActive = false;
            clearInterval(state.timerInterval);
            clearInterval(state.moleTimer);
            hideAllMoles();
            document.getElementById('panel-game-arena').classList.add('hidden');
            document.getElementById('panel-mode-select').classList.remove('hidden');
        }

        function startCountdownTimer() {
            clearInterval(state.timerInterval);
            state.timerInterval = setInterval(() => {
                if (!state.gameActive) return;

                state.timeLeft--;
                document.getElementById('game-timer').innerText = `${state.timeLeft}s`;

                if (state.timeLeft <= 0) {
                    endGameRound();
                }
            }, 1000);
        }

        function endGameRound() {
            state.gameActive = false;
            clearInterval(state.timerInterval);
            clearInterval(state.moleTimer);
            hideAllMoles();

            document.getElementById('summary-round-score').innerText = `+${state.roundScore}`;
            document.getElementById('summary-max-combo').innerText = state.maxCombo;
            document.getElementById('summary-tickets-earned').innerText = `${state.roundTicketsEarned} 張 🎟️`;

            const modal = document.getElementById('modal-game-over');
            const card = document.getElementById('modal-summary-card');
            modal.classList.remove('hidden');
            setTimeout(() => {
                card.classList.remove('scale-95', 'opacity-0');
                card.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeSummaryModal() {
            const modal = document.getElementById('modal-game-over');
            const card = document.getElementById('modal-summary-card');
            card.classList.remove('scale-100', 'opacity-100');
            card.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        function generateNextQuestion() {
            let num1, num2;
            if (state.selectedTable === 'all') {
                num1 = Math.floor(Math.random() * 8) + 2;
            } else {
                num1 = parseInt(state.selectedTable);
            }
            num2 = Math.floor(Math.random() * 9) + 1;
            const answer = num1 * num2;
            state.currentQuestion = { num1, num2, answer };
            document.getElementById('question-text').innerText = `${num1} × ${num2} = ?`;
            hideFeedback();
        }

        // 答錯時顯示正確算式，約 2.5 秒後自動消失
        let feedbackTimer = null;
        function showWrongFeedback() {
            const q = state.currentQuestion;
            document.getElementById('feedback-text').innerText = `${q.num1} × ${q.num2} = ${q.answer}`;
            document.getElementById('feedback-banner').classList.remove('opacity-0');
            clearTimeout(feedbackTimer);
            feedbackTimer = setTimeout(hideFeedback, 2500);
        }

        function hideFeedback() {
            clearTimeout(feedbackTimer);
            const banner = document.getElementById('feedback-banner');
            if (banner) banner.classList.add('opacity-0');
        }

        function startMoleCycle() {
            clearInterval(state.moleTimer);
            popMoles();
            let speedMs = 2000;
            if (state.currentSpeed === 'easy') speedMs = 2800;
            if (state.currentSpeed === 'hard') speedMs = 1200;

            state.moleTimer = setInterval(() => {
                if (state.gameActive) {
                    popMoles();
                }
            }, speedMs);
        }

        function hideAllMoles() {
            for (let i = 0; i < 9; i++) {
                const m = document.getElementById(`mole-${i}`);
                if (m) {
                    m.classList.remove('up', 'whacked');
                }
            }
        }

        function shuffleArray(arr) {
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        // 產生干擾答案：一部分是「容易混淆的接近答案」（例如 7×8 → 7×7=49、7×9=63、6×8=48），
        // 其餘是隨機的九九乘法結果。所有數字都不重複，也不會等於正確答案。
        function buildDistractors(n, num1, num2, ans) {
            const used = new Set([ans]);
            const result = [];
            const inRange = v => v >= 1 && v <= 9;

            // 近似答案比例：慢速較少、快速較多（可自行調整）
            const nearRatio = { easy: 0.3, normal: 0.5, hard: 0.6 }[state.currentSpeed] ?? 0.5;
            const nearTarget = Math.max(1, Math.round(n * nearRatio));

            // 先放 ±1 的（最容易混淆），再放 ±2 的，各組內隨機排序
            const near1 = [[num1, num2 - 1], [num1, num2 + 1], [num1 - 1, num2], [num1 + 1, num2]];
            const near2 = [[num1, num2 - 2], [num1, num2 + 2], [num1 - 2, num2], [num1 + 2, num2]];
            const nearPairs = [...shuffleArray(near1), ...shuffleArray(near2)];

            for (const [a, b] of nearPairs) {
                if (result.length >= nearTarget) break;
                if (!inRange(a) || !inRange(b)) continue;
                const v = a * b;
                if (used.has(v)) continue;
                used.add(v);
                result.push(v);
            }

            // 其餘用隨機九九乘法結果補滿
            let guard = 0;
            while (result.length < n && guard < 200) {
                guard++;
                const v = (Math.floor(Math.random() * 8) + 2) * (Math.floor(Math.random() * 9) + 1);
                if (used.has(v)) continue;
                used.add(v);
                result.push(v);
            }

            return shuffleArray(result);
        }

        // 依速度決定同時冒出的地鼠數量（共 9 個洞）。想調整數量可改這裡 [最少, 最多]
        function getMoleCount() {
            const ranges = {
                easy:   [3, 4],
                normal: [4, 6],
                hard:   [5, 7]
            };
            const [min, max] = ranges[state.currentSpeed] || ranges.normal;
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        function popMoles() {
            hideAllMoles();

            const count = getMoleCount();
            const indices = [];
            while (indices.length < count) {
                const r = Math.floor(Math.random() * 9);
                if (!indices.includes(r)) indices.push(r);
            }

            const correctHole = indices[Math.floor(Math.random() * indices.length)];
            const ans = state.currentQuestion.answer;
            const { num1, num2 } = state.currentQuestion;
            const distractors = buildDistractors(count - 1, num1, num2, ans);

            indices.forEach(idx => {
                let val;
                if (idx === correctHole) {
                    val = ans;
                } else {
                    val = distractors.pop();
                }
                state.activeMoles[idx] = val;
                document.getElementById(`mole-val-${idx}`).innerText = val;

                const moleEl = document.getElementById(`mole-${idx}`);
                if (moleEl) {
                    moleEl.classList.remove('whacked');
                    void moleEl.offsetWidth;
                    moleEl.classList.add('up');
                }
            });
        }

        function whackMole(holeIndex) {
            if(!state.gameActive) return;

            const moleEl = document.getElementById(`mole-${holeIndex}`);
            if(!moleEl.classList.contains('up') || moleEl.classList.contains('whacked')) return;

            const whackedVal = state.activeMoles[holeIndex];

            moleEl.classList.add('whacked');

            if(whackedVal === state.currentQuestion.answer) {
                audio.playHit();
                state.combo += 1;
                if(state.combo > state.maxCombo) state.maxCombo = state.combo;

                if (state.selectedTable === 'all') {
                    state.score += 10;
                    state.roundScore += 10;
                    
                    state.pointsProgress += 10;
                    if (state.pointsProgress >= 100) {
                        state.pointsProgress -= 100;
                        state.tickets += 1;
                        state.roundTicketsEarned += 1;
                        audio.playTicketUnlock();
                        triggerTicketToast();
                    }

                    showScorePopup(holeIndex, '+10', 'text-yellow-300');
                } else {
                    showScorePopup(holeIndex, '答對！🌟', 'text-emerald-300');
                }

                updateStatsUI();
                saveData();

                setTimeout(() => {
                    if (!state.gameActive) return; // 時間到或已結束就不要再冒地鼠
                    generateNextQuestion();
                    startMoleCycle(); // 重新計時，新地鼠才有完整的停留時間
                }, 250);

            } else {
                audio.playMiss();
                state.combo = 0;
                document.getElementById('combo-count').innerText = '0';
                
                showScorePopup(holeIndex, 'X 答錯', 'text-red-400');
                showWrongFeedback();

                const arena = document.getElementById('panel-game-arena');
                arena.classList.add('animate-shake');
                setTimeout(() => arena.classList.remove('animate-shake'), 400);
            }

            document.getElementById('combo-count').innerText = state.combo;
        }

        function showScorePopup(holeIndex, text, colorClass) {
            const hole = document.getElementById(`mole-${holeIndex}`);
            if (!hole) return;
            const popup = document.createElement('div');
            popup.className = `score-popup font-black text-xl sm:text-2xl drop-shadow-md ${colorClass}`;
            popup.innerText = text;

            const layer = document.getElementById('score-popup-layer');
            if (layer) {
                // 以被打到的洞為準定位（洞的水平中心、偏上方）
                const holeBox = hole.parentElement.getBoundingClientRect();
                const layerBox = layer.getBoundingClientRect();
                popup.style.left = `${holeBox.left - layerBox.left + holeBox.width / 2}px`;
                popup.style.top = `${holeBox.top - layerBox.top + holeBox.height * 0.2}px`;

                layer.appendChild(popup);
                setTimeout(() => popup.remove(), 800);
            }
        }

        function triggerTicketToast() {
            const toast = document.getElementById('toast-ticket');
            if (!toast) return;
            toast.classList.remove('-translate-y-20', 'opacity-0', 'pointer-events-none');
            toast.classList.add('translate-y-0', 'opacity-100');
            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('-translate-y-20', 'opacity-0', 'pointer-events-none');
            }, 2000);
        }

        function updateStatsUI() {
            document.getElementById('stat-score').innerText = state.score;

            document.getElementById('stat-draws').innerText = state.tickets;
            document.getElementById('gacha-spins-count').innerText = state.tickets;

            const badgeAlert = document.getElementById('badge-draw-alert');
            const btn1 = document.getElementById('btn-draw-1');
            const btn10 = document.getElementById('btn-draw-10');

            if (btn1) btn1.disabled = (state.tickets < 1);
            if (btn10) btn10.disabled = (state.tickets < 9);

            if (state.tickets > 0) {
                badgeAlert.classList.remove('hidden');
            } else {
                badgeAlert.classList.add('hidden');
            }

            const uniqueCount = Object.keys(state.inventory).length;
            document.getElementById('stat-collected-count').innerText = uniqueCount;
            
            const pct = Math.round((uniqueCount / 20) * 100);
            document.getElementById('collection-progress-bar').style.width = `${pct}%`;
            document.getElementById('collection-progress-text').innerText = `${pct}%`;
        }

        function rollGachaPrize() {
            const rand = Math.random() * 100;
            let pool;
            if (rand < 5) {
                pool = PRIZES.filter(p => p.rarity === 'SR');
            } else if (rand < 35) {
                pool = PRIZES.filter(p => p.rarity === 'R');
            } else {
                pool = PRIZES.filter(p => p.rarity === 'N');
            }
            return pool[Math.floor(Math.random() * pool.length)];
        }

        function playGacha(count) {
            const cost = (count === 10) ? 9 : 1;
            if (state.tickets < cost) return;

            state.tickets -= cost;
            audio.playGachaSpin();

            const knob = document.getElementById('gacha-knob');
            knob.style.transform = 'rotate(360deg)';
            setTimeout(() => knob.style.transform = 'rotate(0deg)', 600);

            const machine = document.getElementById('gacha-machine-body');
            machine.classList.add('animate-gacha-shake');

            setTimeout(() => {
                machine.classList.remove('animate-gacha-shake');

                const pulledPrizes = [];
                let hasSR = false;

                for (let i = 0; i < count; i++) {
                    const prize = rollGachaPrize();
                    pulledPrizes.push(prize);
                    state.inventory[prize.id] = (state.inventory[prize.id] || 0) + 1;
                    if (prize.rarity === 'SR') hasSR = true;
                }

                if (hasSR) audio.playWinSR();

                saveData();
                updateStatsUI();

                showGachaModal(pulledPrizes);
            }, 800);
        }

        function showGachaModal(prizes) {
            const modal = document.getElementById('modal-gacha-result');
            const card = document.getElementById('modal-gacha-card');
            const container = document.getElementById('gacha-results-container');
            const title = document.getElementById('result-modal-title');

            container.innerHTML = '';

            if (prizes.length === 1) {
                const prize = prizes[0];
                title.innerText = "🎉 恭喜獲得！";

                let rarityBg = prize.rarity === 'SR' ? 'rarity-sr' : prize.rarity === 'R' ? 'rarity-r' : 'rarity-n';
                let tagColor = prize.rarity === 'SR' ? 'bg-amber-500' : prize.rarity === 'R' ? 'bg-blue-500' : 'bg-slate-500';
                let tagText = prize.rarity === 'SR' ? '⭐ SR 超級稀有 ⭐' : prize.rarity === 'R' ? '✨ R 高級 ✨' : '🔹 N 普通 🔹';

                container.innerHTML = `
                    <div class="space-y-3">
                        <div class="w-32 h-32 mx-auto rounded-2xl flex items-center justify-center text-6xl shadow-xl ${rarityBg}">
                            <span>${prize.icon}</span>
                        </div>
                        <div class="inline-block px-4 py-1 rounded-full font-black text-xs text-white uppercase tracking-wider ${tagColor} shadow-md">
                            ${tagText}
                        </div>
                        <h3 class="font-black text-2xl text-slate-800">${prize.name}</h3>
                        <p class="text-xs text-slate-500">${prize.desc}</p>
                    </div>
                `;
            } else {
                title.innerText = `🎉 10 連抽結果 (獲得 ${prizes.length} 個獎品！)`;

                const grid = document.createElement('div');
                grid.className = 'grid grid-cols-2 sm:grid-cols-5 gap-2.5 max-h-[60vh] overflow-y-auto p-1';

                prizes.forEach(prize => {
                    let rarityBg = prize.rarity === 'SR' ? 'rarity-sr' : prize.rarity === 'R' ? 'rarity-r' : 'bg-slate-100 border border-slate-300';
                    let rarityBadge = prize.rarity === 'SR' ? 'bg-amber-500' : prize.rarity === 'R' ? 'bg-blue-500' : 'bg-slate-400';

                    grid.innerHTML += `
                        <div class="p-2 rounded-2xl ${rarityBg} flex flex-col items-center justify-between text-center shadow-sm relative">
                            <span class="${rarityBadge} text-white font-black text-[9px] px-1.5 py-0.5 rounded-full absolute top-1 left-1">${prize.rarity}</span>
                            <div class="text-3xl my-1">${prize.icon}</div>
                            <div class="font-bold text-xs text-slate-800 truncate w-full">${prize.name}</div>
                        </div>
                    `;
                });

                container.appendChild(grid);
            }

            modal.classList.remove('hidden');
            setTimeout(() => {
                card.classList.remove('scale-95', 'opacity-0');
                card.classList.add('scale-100', 'opacity-100');
            }, 10);
        }

        function closeGachaModal() {
            const modal = document.getElementById('modal-gacha-result');
            const card = document.getElementById('modal-gacha-card');
            card.classList.remove('scale-100', 'opacity-100');
            card.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 200);
        }

        function filterCollection(rarity) {
            document.querySelectorAll('.btn-filter').forEach(btn => {
                btn.classList.remove('active', 'bg-amber-500', 'text-white');
                btn.classList.add('bg-slate-100', 'text-slate-600');
            });
            if (window.event && window.event.target) {
                window.event.target.classList.remove('bg-slate-100', 'text-slate-600');
                window.event.target.classList.add('active', 'bg-amber-500', 'text-white');
            }

            renderCollectionGrid(rarity);
        }

        function renderCollectionGrid(filter) {
            const grid = document.getElementById('collection-grid');
            if (!grid) return;
            grid.innerHTML = '';

            const filteredPrizes = PRIZES.filter(p => filter === 'all' || p.rarity === filter);

            filteredPrizes.forEach(prize => {
                const count = state.inventory[prize.id] || 0;
                const unlocked = count > 0;

                const card = document.createElement('div');
                card.className = `relative rounded-2xl p-3 text-center border-2 transition flex flex-col justify-between items-center ${
                    unlocked 
                        ? (prize.rarity === 'SR' ? 'bg-amber-50 border-amber-300 shadow-md' : prize.rarity === 'R' ? 'bg-blue-50 border-blue-200' : 'bg-slate-50 border-slate-200')
                        : 'bg-slate-100 border-slate-200 opacity-60 grayscale'
                }`;

                let rarityBadgeColor = prize.rarity === 'SR' ? 'bg-amber-500' : prize.rarity === 'R' ? 'bg-blue-500' : 'bg-slate-400';

                card.innerHTML = `
                    <div class="w-full flex justify-between items-center text-[10px] mb-1">
                        <span class="${rarityBadgeColor} text-white font-bold px-1.5 py-0.5 rounded-md">${prize.rarity}</span>
                        ${unlocked ? `<span class="bg-red-500 text-white font-black px-1.5 py-0.5 rounded-full">x${count}</span>` : '<span class="text-slate-400">未解鎖</span>'}
                    </div>

                    <div class="text-4xl my-2">${unlocked ? prize.icon : '❓'}</div>

                    <div class="w-full">
                        <div class="font-bold text-xs ${unlocked ? 'text-slate-800' : 'text-slate-400'} truncate">${unlocked ? prize.name : '???'}</div>
                        <div class="text-[10px] text-slate-400 truncate mt-0.5">${unlocked ? prize.desc : '尚待抽獎獲得'}</div>
                    </div>
                `;

                grid.appendChild(card);
            });
        }
    </script>
