<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>九九乘法打地鼠 - 趣味學習與扭蛋大冒險</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Noto+Sans+TC:wght@400;700;900&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Fredoka', 'Noto Sans TC', sans-serif;
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
        }

        /* Custom Hammer Cursor */
        .cursor-hammer {
            cursor: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='32' height='32' viewBox='0 0 24 24' fill='%23f59e0b'><path d='M18.7 12.4l-2.1-2.1 3.5-3.5c.8-.8.8-2 0-2.8l-1.4-1.4c-.8-.8-2-.8-2.8 0l-3.5 3.5-2.1-2.1c-.4-.4-1-.4-1.4 0l-1.4 1.4c-.4.4-.4 1 0 1.4l2.1 2.1-7.3 7.3c-.8.8-.8 2 0 2.8l1.4 1.4c.8.8 2 .8 2.8 0l7.3-7.3 2.1 2.1c.4.4 1 .4 1.4 0l1.4-1.4c.4-.4.4-1 0-1.4z'/></svg>") 16 16, auto;
        }

        /* Mole Hole & Animations */
        .dirt-hole {
            background: linear-gradient(180deg, #5c3a21 0%, #3d2310 100%);
            box-shadow: inset 0 8px 12px rgba(0,0,0,0.6), 0 4px 6px rgba(0,0,0,0.2);
            border: 4px solid #8b5a2b;
        }

        .mole {
            transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            transform: translateY(100%);
        }

        .mole.up {
            transform: translateY(10%);
        }

        .mole.whacked {
            transform: translateY(80%) scale(0.9);
            filter: brightness(0.7) hue-rotate(-30deg);
        }

        /* Pop Up Effect */
        @keyframes popUpText {
            0% { opacity: 0; transform: translate(-50%, 0) scale(0.5); }
            50% { opacity: 1; transform: translate(-50%, -30px) scale(1.3); }
            100% { opacity: 0; transform: translate(-50%, -60px) scale(1); }
        }

        .score-popup {
            position: absolute;
            left: 50%;
            top: 20%;
            animation: popUpText 0.8s ease-out forwards;
            pointer-events: none;
            z-index: 50;
        }

        /* Shake Animation */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }

        .animate-shake {
            animation: shake 0.4s ease-in-out;
        }

        /* Gacha Machine Animation */
        @keyframes gachaShake {
            0%, 100% { transform: rotate(0deg); }
            25% { transform: rotate(-6deg); }
            75% { transform: rotate(6deg); }
        }

        .animate-gacha-shake {
            animation: gachaShake 0.3s ease-in-out infinite;
        }

        /* Rarity Visual Themes */
        .rarity-sr {
            background: linear-gradient(135deg, #fef08a, #f59e0b, #d97706);
            box-shadow: 0 0 20px rgba(245, 158, 11, 0.6);
            border: 3px solid #fef08a;
        }
        .rarity-r {
            background: linear-gradient(135deg, #e0f2fe, #3b82f6, #1d4ed8);
            box-shadow: 0 0 15px rgba(59, 130, 246, 0.5);
            border: 3px solid #93c5fd;
        }
        .rarity-n {
            background: linear-gradient(135deg, #f3f4f6, #9ca3af, #4b5563);
            box-shadow: 0 0 10px rgba(156, 163, 175, 0.3);
            border: 3px solid #e5e7eb;
        }

        body { -webkit-tap-highlight-color: transparent; min-height: 100vh !important; min-height: 100dvh !important; }

        /* ===== 手機版（直立）排版：目標是遊戲中不用捲動畫面 ===== */
        @media (max-width: 639px) {
            /* 洞的高度依螢幕高度縮放（dvh 不支援時退回 vh） */
            .hole-cell {
                height: clamp(6rem, 15vh, 7.5rem) !important;
                height: clamp(6rem, 15dvh, 7.5rem) !important;
            }
            #panel-mode-select, #sec-gacha > div, #sec-collection > div { padding: 1rem !important; }
            #panel-mode-select > :not([hidden]) ~ :not([hidden]) { margin-top: 1rem !important; }
            .btn-mode { font-size: 1rem !important; padding-top: .6rem !important; padding-bottom: .6rem !important; }
            nav button { font-size: .85rem !important; padding-top: .4rem !important; padding-bottom: .4rem !important; }
            #timer-box { padding: .25rem .6rem !important; font-size: .85rem !important; }
            #game-timer { font-size: 1.1rem !important; min-width: 2.2rem !important; }
            #toast-ticket { width: max-content; max-width: 92vw; padding: .5rem 1rem; }
            #toast-ticket span { font-size: .95rem; }
            #btn-draw-1, #btn-draw-10 { font-size: 1rem; }
            .btn-filter { padding-left: .6rem !important; padding-right: .6rem !important; }
            footer { display: none; }
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-amber-50 min-h-screen text-slate-800 flex flex-col justify-between cursor-hammer selection:bg-amber-200">

    <!-- TOP NAVIGATION & STATUS BAR -->
    <header class="bg-amber-500 text-white shadow-lg sticky top-0 z-40">
        <div class="max-w-4xl mx-auto px-3 py-2 sm:px-4 sm:py-3 flex flex-nowrap sm:flex-wrap justify-between items-center gap-2">
            <!-- Game Title & Logo -->
            <div class="flex items-center space-x-2 cursor-pointer" onclick="switchTab('game')">
                <div class="bg-white text-amber-600 p-2 rounded-2xl shadow-inner text-base sm:text-xl flex items-center justify-center w-8 h-8 sm:w-10 sm:h-10">
                    <i class="fa-solid fa-gavel"></i>
                </div>
                <div>
                    <h1 class="font-black text-base sm:text-xl leading-tight tracking-wide">九九乘法打地鼠</h1>
                    <p class="hidden sm:block text-xs text-amber-100 font-medium">邊玩邊學乘法 ‧ 收集20種卡牌！</p>
                </div>
            </div>

            <!-- Stats Bar -->
            <div class="flex items-center space-x-2 sm:space-x-3 text-xs sm:text-sm">
                <!-- Score Display -->
                <div class="bg-amber-600/80 px-3 py-1.5 rounded-xl flex items-center space-x-1.5 border border-amber-400">
                    <i class="fa-solid fa-star text-yellow-300 text-base"></i>
                    <span class="hidden sm:inline font-bold">得分:</span>
                    <span id="stat-score" class="font-black text-lg text-yellow-200">0</span>
                </div>

                <!-- Gacha Tickets -->
                <button onclick="switchTab('gacha')" class="relative bg-gradient-to-r from-pink-500 to-purple-600 hover:from-pink-600 hover:to-purple-700 text-white px-3 py-1.5 rounded-xl font-bold flex items-center space-x-1.5 transition transform active:scale-95 shadow border border-pink-300">
                    <i class="fa-solid fa-ticket text-yellow-300 animate-bounce"></i>
                    <span class="hidden sm:inline">抽獎卷:</span>
                    <span id="stat-draws" class="font-black text-base text-yellow-200">0</span>
                    <span id="badge-draw-alert" class="hidden absolute -top-1 -right-1 bg-red-500 text-white text-xs font-bold px-1.5 py-0.5 rounded-full animate-ping">!</span>
                </button>

                <!-- Mute Toggle Button -->
                <button id="btn-sound" onclick="toggleSound()" class="bg-amber-600 hover:bg-amber-700 p-2 rounded-xl text-amber-100 transition">
                    <i class="fa-solid fa-volume-high text-base"></i>
                </button>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="bg-amber-600 border-t border-amber-400/50">
            <div class="max-w-4xl mx-auto flex justify-around">
                <button id="tab-game" onclick="switchTab('game')" class="flex-1 py-2 font-bold text-center border-b-4 border-yellow-300 text-yellow-200 flex items-center justify-center space-x-1 transition">
                    <i class="fa-solid fa-gamepad"></i>
                    <span>挑戰遊戲</span>
                </button>
                <button id="tab-gacha" onclick="switchTab('gacha')" class="flex-1 py-2 font-bold text-center border-b-4 border-transparent text-amber-200 hover:text-white flex items-center justify-center space-x-1 transition">
                    <i class="fa-solid fa-gift"></i>
                    <span>扭蛋抽獎</span>
                </button>
                <button id="tab-collection" onclick="switchTab('collection')" class="flex-1 py-2 font-bold text-center border-b-4 border-transparent text-amber-200 hover:text-white flex items-center justify-center space-x-1 transition">
                    <i class="fa-solid fa-book-open"></i>
                    <span>收藏圖鑑 (<span id="stat-collected-count">0</span>/20)</span>
                </button>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="max-w-4xl mx-auto w-full px-2 py-2 sm:px-4 sm:py-6 flex-1 flex flex-col justify-center">

        <!-- TAB 1: GAME SECTION -->
        <section id="sec-game" class="block space-y-6">

            <!-- MODE SELECTOR MODAL / PANEL (Visible when game not active) -->
            <div id="panel-mode-select" class="bg-white rounded-3xl p-6 shadow-xl border-4 border-amber-200 text-center space-y-6">
                <div class="space-y-2">
                    <h2 class="text-2xl font-black text-amber-800 flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-bullseye text-amber-500"></i>
                        <span>選擇乘法練習或挑戰模式</span>
                    </h2>
                    <div class="bg-amber-50 p-3 rounded-2xl border border-amber-200 text-sm text-slate-600 space-y-1">
                        <p>🔹 <span class="font-bold text-sky-700">【2~9 單一數字】</span>：無限時練習模式（不累積分數與抽獎卷，適合練習）</p>
                        <p>🌟 <span class="font-bold text-amber-700">【全綜合 🌟】</span>：1 分鐘限時挑戰模式（可累積分數與自動換取抽獎卷！）</p>
                    </div>
                </div>

                <!-- Number Table Buttons -->
                <div>
                    <label class="block font-bold text-slate-700 mb-3 text-left">
                        <i class="fa-solid fa-filter text-amber-500 mr-1"></i> 請選擇模式：
                    </label>
                    <div class="grid grid-cols-3 sm:grid-cols-9 gap-2">
                        <button onclick="selectMode(2)" class="btn-mode font-bold text-lg py-3 rounded-2xl border-2 border-amber-300 bg-amber-50 hover:bg-amber-400 hover:text-white text-amber-800 transition shadow-sm" data-table="2">2 的乘法</button>
                        <button onclick="selectMode(3)" class="btn-mode font-bold text-lg py-3 rounded-2xl border-2 border-amber-300 bg-amber-50 hover:bg-amber-400 hover:text-white text-amber-800 transition shadow-sm" data-table="3">3 的乘法</button>
                        <button onclick="selectMode(4)" class="btn-mode font-bold text-lg py-3 rounded-2xl border-2 border-amber-300 bg-amber-50 hover:bg-amber-400 hover:text-white text-amber-800 transition shadow-sm" data-table="4">4 的乘法</button>
                        <button onclick="selectMode(5)" class="btn-mode font-bold text-lg py-3 rounded-2xl border-2 border-amber-300 bg-amber-50 hover:bg-amber-400 hover:text-white text-amber-800 transition shadow-sm" data-table="5">5 的乘法</button>
                        <button onclick="selectMode(6)" class="btn-mode font-bold text-lg py-3 rounded-2xl border-2 border-amber-300 bg-amber-50 hover:bg-amber-400 hover:text-white text-amber-800 transition shadow-sm" data-table="6">6 的乘法</button>
                        <button onclick="selectMode(7)" class="btn-mode font-bold text-lg py-3 rounded-2xl border-2 border-amber-300 bg-amber-50 hover:bg-amber-400 hover:text-white text-amber-800 transition shadow-sm" data-table="7">7 的乘法</button>
                        <button onclick="selectMode(8)" class="btn-mode font-bold text-lg py-3 rounded-2xl border-2 border-amber-300 bg-amber-50 hover:bg-amber-400 hover:text-white text-amber-800 transition shadow-sm" data-table="8">8 的乘法</button>
                        <button onclick="selectMode(9)" class="btn-mode font-bold text-lg py-3 rounded-2xl border-2 border-amber-300 bg-amber-50 hover:bg-amber-400 hover:text-white text-amber-800 transition shadow-sm" data-table="9">9 的乘法</button>
                        <button onclick="selectMode('all')" class="btn-mode active bg-amber-500 text-white font-bold text-lg py-3 rounded-2xl border-2 border-amber-500 hover:bg-amber-600 transition shadow-md col-span-3 sm:col-span-1" data-table="all">全綜合 🌟</button>
                    </div>
                </div>

                <!-- Speed / Difficulty Option -->
                <div class="flex flex-wrap justify-center items-center gap-4 bg-amber-100/50 p-4 rounded-2xl">
                    <span class="font-bold text-slate-700">地鼠速度：</span>
                    <label class="inline-flex items-center cursor-pointer">
                        <input type="radio" name="speed" value="easy" class="form-radio text-amber-500 h-5 w-5">
                        <span class="ml-2 font-bold text-slate-600">慢速 (輕鬆)</span>
                    </label>
                    <label class="inline-flex items-center cursor-pointer">
                        <input type="radio" name="speed" value="normal" checked class="form-radio text-amber-500 h-5 w-5">
                        <span class="ml-2 font-bold text-slate-600">標準 (推薦)</span>
                    </label>
                    <label class="inline-flex items-center cursor-pointer">
                        <input type="radio" name="speed" value="hard" class="form-radio text-amber-500 h-5 w-5">
                        <span class="ml-2 font-bold text-slate-600">快速 (高手)</span>
                    </label>
                </div>

                <!-- Start Game Button -->
                <button onclick="startGame()" class="w-full sm:w-2/3 mx-auto py-4 bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-600 hover:to-emerald-700 text-white font-black text-2xl rounded-2xl shadow-lg border-b-4 border-green-700 transform hover:-translate-y-1 transition active:translate-y-0 flex items-center justify-center space-x-3">
                    <i class="fa-solid fa-play"></i>
                    <span>開始打了！</span>
                </button>
            </div>

            <!-- ACTIVE GAME ARENA (Hidden by default) -->
            <div id="panel-game-arena" class="hidden space-y-2 sm:space-y-4">
                
                <!-- Question Banner & Game Control Bar -->
                <div class="bg-white rounded-3xl p-2 sm:p-4 shadow-lg border-4 border-amber-300 flex flex-wrap md:flex-nowrap items-center justify-between gap-2 sm:gap-4">
                    <!-- Mode badge & Timer -->
                    <div class="flex items-center space-x-2 sm:space-x-3 order-1 md:order-none">
                        <span id="badge-current-mode" class="hidden sm:inline-block bg-amber-100 text-amber-800 px-3 py-1.5 rounded-full font-bold text-sm border border-amber-300">模式: 全綜合</span>
                        
                        <!-- Dynamic Timer Box -->
                        <div id="timer-box" class="bg-rose-500 text-white px-3.5 py-1.5 rounded-2xl font-black text-base flex items-center space-x-1.5 shadow-md border border-rose-400">
                            <i class="fa-solid fa-clock text-yellow-300 animate-spin"></i>
                            <span id="timer-label">剩餘:</span>
                            <span id="game-timer" class="text-xl text-yellow-200 min-w-[2.5rem] text-center">60s</span>
                        </div>

                        <button onclick="stopGame()" class="text-xs bg-slate-200 hover:bg-slate-300 text-slate-600 font-bold px-3 py-1.5 rounded-full transition cursor-pointer">
                            <i class="fa-solid fa-rotate-left mr-1"></i>結束
                        </button>
                    </div>

                    <!-- Target Question Box -->
                    <div class="bg-amber-500 text-white px-4 sm:px-8 py-1.5 sm:py-2.5 rounded-2xl shadow-inner border-2 border-amber-300 flex items-center justify-center space-x-3 order-3 md:order-none w-full md:w-auto">
                        <span class="text-amber-200 text-sm font-bold uppercase tracking-wider">題目:</span>
                        <span id="question-text" class="font-black text-3xl sm:text-4xl tracking-wider text-yellow-200 animate-pulse">7 × 8 = ?</span>
                    </div>

                    <!-- Continuous Streak Counter -->
                    <div class="flex items-center space-x-2 bg-orange-50 px-3 sm:px-4 py-1 sm:py-1.5 rounded-2xl border border-orange-200 order-2 md:order-none">
                        <i class="fa-solid fa-fire text-orange-500 text-xl"></i>
                        <div class="text-left">
                            <div class="text-xs text-slate-400 font-bold">連對 Combo</div>
                            <div id="combo-count" class="text-lg font-black text-orange-600 leading-none">0</div>
                        </div>
                    </div>
                </div>

                <!-- 答錯時顯示正確算式（固定保留空間，避免畫面跳動） -->
                <div class="h-8 sm:h-11 flex items-center justify-center">
                    <div id="feedback-banner" class="opacity-0 transition-opacity duration-200 bg-rose-100 text-rose-700 border-2 border-rose-300 font-black text-base sm:text-xl px-4 sm:px-5 py-0.5 sm:py-1 rounded-2xl shadow">
                        <i class="fa-solid fa-lightbulb text-amber-500 mr-1"></i>正確答案：<span id="feedback-text"></span>
                    </div>
                </div>

                <!-- 3x3 Mole Holes Grid Container -->
                <div class="relative bg-emerald-600 p-2 sm:p-6 rounded-3xl shadow-2xl border-4 border-emerald-800">
                    <div class="absolute inset-0 bg-[radial-gradient(#10b981_1px,transparent_1px)] [background-size:16px_16px] opacity-30 pointer-events-none rounded-3xl"></div>

                    <!-- Floating Score Notification Layer -->
                    <div id="score-popup-layer" class="absolute inset-0 pointer-events-none overflow-hidden z-30"></div>

                    <!-- Grid -->
                    <div class="grid grid-cols-3 gap-2 sm:gap-6 relative z-10">
                        <script>
                            for(let i=0; i<9; i++){
                                document.write(`
                                <div class="relative flex flex-col items-center justify-end hole-cell h-28 sm:h-36 overflow-hidden rounded-full border-b-8 border-emerald-900 bg-emerald-800/40 p-1">
                                    <div class="dirt-hole absolute bottom-0 w-full h-14 sm:h-20 rounded-full z-0"></div>

                                    <div id="mole-${i}" onclick="whackMole(${i})" class="mole relative z-10 cursor-pointer flex flex-col items-center select-none w-16 sm:w-28">
                                        <div class="relative bg-amber-800 w-14 sm:w-20 h-14 sm:h-20 rounded-t-full border-2 border-amber-900 shadow-md flex flex-col items-center justify-start pt-2">
                                            <div class="flex space-x-2 mb-1">
                                                <div class="w-2.5 h-2.5 bg-black rounded-full border border-white"></div>
                                                <div class="w-2.5 h-2.5 bg-black rounded-full border border-white"></div>
                                            </div>
                                            <div class="w-5 h-3 bg-pink-300 rounded-full border border-pink-400"></div>
                                            <div class="absolute top-6 left-1 w-2.5 h-2.5 bg-red-400/50 rounded-full"></div>
                                            <div class="absolute top-6 right-1 w-2.5 h-2.5 bg-red-400/50 rounded-full"></div>
                                        </div>

                                        <div class="bg-yellow-100 text-slate-900 font-black text-xl sm:text-2xl px-2 py-0.5 sm:py-1 rounded-lg border-2 border-amber-600 shadow-md transform -translate-y-2 z-20 min-w-[3.5rem] text-center">
                                            <span id="mole-val-${i}">0</span>
                                        </div>
                                    </div>
                                </div>
                                `);
                            }
                        </script>
                    </div>
                </div>
            </div>
        </section>

        <!-- TAB 2: GACHA SECTION -->
        <section id="sec-gacha" class="hidden space-y-6">
            <div class="bg-white rounded-3xl p-6 shadow-xl border-4 border-pink-200 text-center space-y-6 relative overflow-hidden">
                <div class="absolute -top-10 -left-10 w-32 h-32 bg-pink-100 rounded-full filter blur-xl opacity-70"></div>
                <div class="absolute -bottom-10 -right-10 w-32 h-32 bg-purple-100 rounded-full filter blur-xl opacity-70"></div>

                <div class="relative z-10 space-y-2">
                    <h2 class="text-3xl font-black text-pink-600 flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-gift text-pink-500"></i>
                        <span>乘法大師扭蛋機</span>
                    </h2>
                    <p class="text-slate-500 text-sm">每累積 100 分可免費換 1 張抽獎卷！收集 20 種精美地鼠卡牌與珍貴道具！</p>
                </div>

                <!-- Gacha Machine Visual Display -->
                <div class="relative max-w-xs mx-auto my-4">
                    <div id="gacha-machine-body" class="bg-gradient-to-b from-red-500 via-pink-500 to-red-600 p-6 rounded-t-full rounded-b-3xl border-4 border-red-700 shadow-2xl relative">
                        <div class="bg-sky-100/30 border-4 border-white/60 rounded-full h-48 w-48 mx-auto flex items-center justify-center relative overflow-hidden shadow-inner backdrop-blur-sm">
                            <div class="absolute top-8 left-6 w-10 h-10 rounded-full bg-gradient-to-tr from-yellow-400 to-orange-400 border-2 border-white shadow"></div>
                            <div class="absolute top-12 right-8 w-10 h-10 rounded-full bg-gradient-to-tr from-blue-400 to-indigo-500 border-2 border-white shadow"></div>
                            <div class="absolute bottom-8 left-10 w-10 h-10 rounded-full bg-gradient-to-tr from-green-400 to-emerald-500 border-2 border-white shadow"></div>
                            <div class="absolute bottom-6 right-8 w-10 h-10 rounded-full bg-gradient-to-tr from-purple-400 to-pink-500 border-2 border-white shadow"></div>
                            <div class="absolute top-20 left-16 w-12 h-12 rounded-full bg-gradient-to-tr from-amber-300 to-yellow-500 border-2 border-white shadow animate-pulse"></div>
                        </div>

                        <!-- Knob -->
                        <div class="mt-4 bg-slate-200 border-2 border-slate-400 rounded-2xl p-3 w-32 mx-auto shadow-inner flex flex-col items-center">
                            <div id="gacha-knob" class="w-12 h-4 bg-red-600 rounded-full border-2 border-red-800 shadow cursor-pointer transform transition-transform duration-500"></div>
                            <div class="text-[10px] font-bold text-slate-500 mt-1">TURN HERE</div>
                        </div>

                        <!-- Exit Slot -->
                        <div class="mt-3 bg-slate-900 rounded-xl h-10 w-20 mx-auto border-2 border-slate-700 flex items-center justify-center">
                            <div id="capsule-exit-zone" class="relative"></div>
                        </div>
                    </div>
                </div>

                <!-- Draw Action Buttons -->
                <div class="space-y-3 relative z-10">
                    <div class="text-sm font-bold text-slate-600">
