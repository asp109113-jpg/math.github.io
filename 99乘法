                btn.innerHTML = '<i class="fa-solid fa-volume-high text-base"></i>';
                btn.classList.remove('bg-slate-500');
            }
        }

        // 20 PRIZE COLLECTIBLES DATA REGISTRY
        const PRIZES = [
